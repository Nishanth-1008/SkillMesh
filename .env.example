# SkillMesh environment variables
# Copy to `.env` (repo root) or `backend/.env` and fill in values.
# `.env.local` is preferred for secrets and is gitignored.
# Neon: https://console.neon.tech -> your project -> Connection string

# --- Database (Neon / any Postgres) ---
# Full connection URL (preferred). Example Neon:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional overrides if you prefer discrete fields instead of DATABASE_URL
# PGHOST=ep-xxx.region.aws.neon.tech
# PGPORT=5432
# PGDATABASE=neondb
# PGUSER=neondb_owner
# PGPASSWORD=YOUR_PASSWORD

# Neon and most cloud Postgres require TLS
DATABASE_SSL=true

# Pool size (Neon free tier: keep small)
DATABASE_POOL_MAX=5

# --- Auth ---
# REQUIRED in production. Generate with: openssl rand -hex 64
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_SECONDS=604800

# --- Server ---
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated allowed browser origins (* = allow all, fine for local demo)
# In production list explicit origins, e.g. https://app.example.com,https://admin.example.com
CORS_ORIGIN=*
# ALLOWED_ORIGINS=https://app.example.com

# API rate limit per IP (requests per minute, sliding window)
RATE_LIMIT_PER_MINUTE=100

# --- Static assets & backups ---
# Directory served for non-API GETs (defaults to repo frontend/)
# STATIC_DIR=/abs/path/to/frontend
# Directory for automatic db snapshots and `npm run db:backup`
# BACKUP_DIR=/abs/path/to/backend/data/backups

# --- AI: intent understanding (Phase 2) ---
# When set, query understanding (POST /api/search, /api/recommendations/ask)
# runs through an OpenAI-compatible chat endpoint; otherwise a deterministic
# heuristic extractor is used. Responses include understanding.source.
# Example with Gemini (OpenAI-compatible endpoint):
# LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=gemini-2.5-flash
# LLM_TIMEOUT_MS=8000

# --- AI: semantic embeddings / pgvector (Phase 2) ---
# When set, text embeddings come from an OpenAI-compatible /v1/embeddings
# endpoint; otherwise a deterministic local embedding is used (no network).
# External vectors are resized to the local dimension (384) so they stay
# compatible with the pgvector column, which is fixed at vector(384).
# EMBEDDING_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/embeddings
# EMBEDDING_API_KEY=your-gemini-key
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_TIMEOUT_MS=8000

# --- Frontend (served separately; also mirrored in frontend/js/config.js) ---
# Browser calls this base for API requests
SKILLMESH_API_BASE=http://localhost:4000/api
