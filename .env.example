# SkillMesh environment variables
# Copy to `.env` or `.env.local` in the project root (or `backend/`) and fill in values.
# `.env.local` is preferred for secrets and is gitignored.
# Neon: https://console.neon.tech → your project → Connection string

# --- Database (Neon / any Postgres) ---
# Full connection URL (preferred). Example Neon:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Optional overrides if you prefer discrete fields instead of DATABASE_URL
# PGHOST=ep-xxx.region.aws.neon.tech
# PGPORT=5432
# PGDATABASE=neondb
# PGUSER=neondb_owner
# PGPASSWORD=YOUR_PASSWORD

# Neon and most cloud Postgres require TLS
DATABASE_SSL=true

# Pool size (Neon free tier: keep small)
DATABASE_POOL_MAX=5

# --- Auth ---
# REQUIRED in production. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_SECONDS=604800

# --- Server ---
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated allowed browser origins (* = allow all, fine for local demo)
CORS_ORIGIN=*

# --- Frontend (served separately; also mirrored in frontend/js/config.js) ---
# Browser calls this base for API requests
SKILLMESH_API_BASE=http://localhost:4000/api
