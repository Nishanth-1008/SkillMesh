{
  "name": "skillmesh-backend",
  "version": "0.7.0",
  "description": "SkillMesh Phases 1–6 — Postgres/Neon-backed community intelligence API",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "test": "node src/tests/run_tests.js",
    "seed": "node src/seed.js",
    "db:migrate": "node src/db/migrate.js",
    "db:reset": "node src/db/migrate.js && node src/seed.js",
    "db:backup": "node src/scripts/backup.js",
    "db:restore": "node src/scripts/restore.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "pg": "^8.13.3",
    "zod": "^4.4.3"
  }
}
